# OpenRouter API Key
OPENROUTER_API_KEY=

# Fal.ai API Key (format: key_id:key_secret)
FAL_API_KEY=

# Kie.ai API Key
KIE_API_KEY=your_kie_api_key_here

# Blotato API Key
BLOTATO_API_KEY=

# Blotato Account IDs (comma-separated for each platform)
BLOTATO_YOUTUBE_ACCOUNT_ID=
BLOTATO_TIKTOK_ACCOUNT_ID=
BLOTATO_INSTAGRAM_ACCOUNT_ID=
BLOTATO_X_ACCOUNT_ID=
BLOTATO_FACEBOOK_ACCOUNT_ID=
BLOTATO_LINKEDIN_ACCOUNT_ID=
BLOTATO_PINTEREST_ACCOUNT_ID=
BLOTATO_THREADS_ACCOUNT_ID=

# Server Port
PORT=3001
